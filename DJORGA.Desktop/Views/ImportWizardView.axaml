<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DJORGA.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="550"
             x:Class="DJORGA.Desktop.Views.ImportWizardView"
             x:DataType="vm:ImportWizardViewModel">
    
    <ScrollViewer Background="#121212">
        <StackPanel Margin="40" Spacing="30" MaxWidth="700" HorizontalAlignment="Center">
            
            <!-- Header -->
            <StackPanel Spacing="10">
                <TextBlock Text="Import Rekordbox Library" FontSize="28" FontWeight="Light" Foreground="White"/>
                <TextBlock Text="Follow these steps to connect your music to DJORGA." FontSize="16" Foreground="Gray"/>
            </StackPanel>

            <!-- Instructions -->
            <Border Background="#1a1a1a" CornerRadius="15" Padding="20" BoxShadow="0 4 15 0 #20000000">
                <StackPanel Spacing="15">
                    <TextBlock Text="How to export from Rekordbox:" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="1. Open Pioneer Rekordbox." Foreground="Gray"/>
                    <TextBlock Text="2. Go to File -> Export Collection in XML format." Foreground="Gray"/>
                    <TextBlock Text="3. Save the file (e.g., to your Documents folder)." Foreground="Gray"/>
                </StackPanel>
            </Border>

            <!-- Auto-Detected Files -->
            <StackPanel Spacing="15">
                <TextBlock Text="Detected XML files on your system:" FontWeight="Bold" Foreground="White"/>
                
                <ItemsControl ItemsSource="{Binding DetectedPaths}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#252525" CornerRadius="12" Margin="0,0,0,10" Padding="15" BoxShadow="0 2 10 0 #10000000">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Import this file" 
                                            Command="{Binding $parent[UserControl].((vm:ImportWizardViewModel)DataContext).ImportCommand}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding !$parent[UserControl].((vm:ImportWizardViewModel)DataContext).IsLoading}"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="Gray" TextTrimming="PathEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock IsVisible="{Binding !DetectedPaths.Count}" 
                           Text="No XML files found automatically. Please browse manually." 
                           Foreground="#888" FontStyle="Italic"/>
            </StackPanel>

            <!-- Manual Selection -->
            <StackPanel Spacing="15">
                <TextBlock Text="Or select your file manually:" FontWeight="Bold" Foreground="White"/>
                <Button Content="Browse for XML file..." 
                        Command="{Binding BrowseCommand}"
                        HorizontalAlignment="Left"
                        Padding="20,10"/>
            </StackPanel>

            <!-- Status -->
            <StackPanel IsVisible="{Binding IsLoading}" Spacing="10" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="2"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="14" Foreground="#40FFFFFF" HorizontalAlignment="Center"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
