<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DJORGA.Desktop.Views.SettingsView">
    <StackPanel Margin="40" Spacing="20">
        <TextBlock Text="Settings" FontSize="32" FontWeight="Light"/>
        <Border Background="#1a1a1a" CornerRadius="15" Padding="30">
            <TextBlock Text="Configuration options will appear here." Foreground="Gray"/>
        </Border>
    </StackPanel>
</UserControl>
