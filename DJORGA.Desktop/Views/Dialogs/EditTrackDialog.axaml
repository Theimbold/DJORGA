<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:DJORGA.Desktop.ViewModels"
        xmlns:controls="using:DJORGA.Desktop.Controls"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="750"
        x:Class="DJORGA.Desktop.Views.Dialogs.EditTrackDialog"
        x:DataType="vm:EditTrackViewModel"
        Title="Edit Track"
        Width="500" Height="750"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur">

    <Border Background="#252525" 
            CornerRadius="20" 
            BorderBrush="#333" 
            BorderThickness="1"
            BoxShadow="0 10 30 0 #80000000"
            Margin="20">
        <Grid RowDefinitions="Auto, *, Auto" Margin="30">
            <!-- Header -->
            <TextBlock Grid.Row="0" Text="Edit Track DNA &amp; Metadata" FontSize="22" FontWeight="Light" Margin="0,0,0,30" LetterSpacing="1"/>

            <!-- Form -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="15">
                    <!-- DNA Section -->
                    <StackPanel Spacing="10" Margin="0,0,0,10">
                        <TextBlock Text="Contextual DNA (Mood vs. Time)" Foreground="Gray" FontSize="12"/>
                        <Border Background="#1a1a1a" CornerRadius="12" Padding="15">
                            <StackPanel Spacing="10">
                                <controls:DnaPickerControl Height="200" 
                                                          SelectedMood="{Binding Mood, Mode=TwoWay}"
                                                          SelectedTimeContext="{Binding TimeContext, Mode=TwoWay}"/>
                                <Grid ColumnDefinitions="*, *">
                                    <TextBlock Grid.Column="0" Text="{Binding Mood}" Foreground="#aaa" FontSize="11" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TimeContext}" Foreground="#aaa" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="5">
                        <TextBlock Text="Title" Foreground="Gray" FontSize="12"/>
                        <TextBox Text="{Binding Title}" Background="#1a1a1a" BorderThickness="0" CornerRadius="8"/>
                    </StackPanel>

                    <StackPanel Spacing="5">
                        <TextBlock Text="Artist" Foreground="Gray" FontSize="12"/>
                        <TextBox Text="{Binding Artist}" Background="#1a1a1a" BorderThickness="0" CornerRadius="8"/>
                    </StackPanel>

                    <StackPanel Spacing="5">
                        <TextBlock Text="Album" Foreground="Gray" FontSize="12"/>
                        <TextBox Text="{Binding Album}" Background="#1a1a1a" BorderThickness="0" CornerRadius="8"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*, 20">
                        <StackPanel Grid.Column="0" Spacing="5">
                            <TextBlock Text="Genre" Foreground="Gray" FontSize="12"/>
                            <TextBox Text="{Binding Genre}" Background="#1a1a1a" BorderThickness="0" CornerRadius="8"/>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*, 20, *">
                        <StackPanel Grid.Column="0" Spacing="5">
                            <TextBlock Text="BPM" Foreground="Gray" FontSize="12"/>
                            <NumericUpDown Value="{Binding Bpm}" Minimum="0" Maximum="300" Background="#1a1a1a" BorderThickness="0" CornerRadius="8"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="5">
                            <TextBlock Text="Key" Foreground="Gray" FontSize="12"/>
                            <TextBox Text="{Binding Key}" Background="#1a1a1a" BorderThickness="0" CornerRadius="8"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="15" Margin="0,30,0,0">
                <Button Content="Cancel" Command="{Binding CancelCommand}" Background="Transparent" BorderThickness="0"/>
                <Button Content="Save Changes" 
                        Command="{Binding SaveCommand}" 
                        Background="#4CAF50" 
                        Foreground="White" 
                        Padding="25,10"
                        CornerRadius="10"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
