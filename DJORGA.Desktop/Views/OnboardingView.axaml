<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DJORGA.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DJORGA.Desktop.Views.OnboardingView"
             x:DataType="vm:OnboardingViewModel">
    
    <Panel Background="#121212">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="30">
            <!-- Platzhalter für Logo/Icon -->
            <Border Width="120" Height="120" CornerRadius="60" Background="#1a1a1a" BoxShadow="0 0 20 0 #40FFFFFF">
                <Path Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z" 
                      Fill="White" Width="50" Height="50" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Spacing="10" HorizontalAlignment="Center">
                <TextBlock Text="Welcome to DJORGA" FontSize="32" FontWeight="Light" HorizontalAlignment="Center" Foreground="White"/>
                <TextBlock Text="Your library is currently empty. Start by importing your Rekordbox XML." 
                           FontSize="16" Foreground="Gray" HorizontalAlignment="Center"/>
            </StackPanel>

            <Button Content="Get Started &amp; Import XML" 
                    Command="{Binding StartImportCommand}"
                    HorizontalAlignment="Center"
                    FontSize="18"
                    Padding="30,15"/>
        </StackPanel>
    </Panel>
</UserControl>
