<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:MyApp.Desktop.ViewModels"
        xmlns:vo="using:MyApp.Domain.ValueObjects"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
        x:Class="MyApp.Desktop.Views.Dialogs.SmartCollectionEditorDialog"
        x:DataType="vm:SmartCollectionEditorViewModel"
        Title="Smart Collection Editor"
        Width="650" Height="550"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur">

    <Border Background="#252525" 
            CornerRadius="20" 
            BorderBrush="#333" 
            BorderThickness="1"
            BoxShadow="0 10 30 0 #80000000"
            Margin="20">
        <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="30">
            <!-- Header -->
            <TextBlock Grid.Row="0" Text="Smart Collection Editor" FontSize="22" FontWeight="Light" Margin="0,0,0,25"/>

            <!-- Basic Info -->
            <StackPanel Grid.Row="1" Spacing="15" Margin="0,0,0,20">
                <StackPanel Spacing="5">
                    <TextBlock Text="Collection Name" Foreground="Gray" FontSize="12"/>
                    <TextBox Text="{Binding Name}" Watermark="e.g. My Favorite House" CornerRadius="8"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Spacing="20">
                    <TextBlock Text="Match:" VerticalAlignment="Center" Foreground="Gray" FontSize="12"/>
                    <RadioButton Content="All rules (AND)" IsChecked="{Binding MatchAllRules}" GroupName="MatchType"/>
                    <RadioButton Content="Any rule (OR)" IsChecked="{Binding !MatchAllRules}" GroupName="MatchType"/>
                </StackPanel>
            </StackPanel>

            <!-- Rules List -->
            <Border Grid.Row="2" Background="#1a1a1a" CornerRadius="12" Padding="10">
                <Grid RowDefinitions="*, Auto">
                    <ScrollViewer Grid.Row="0">
                        <ItemsControl ItemsSource="{Binding Rules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FilterRuleViewModel">
                                    <Grid ColumnDefinitions="*, *, *, Auto" Margin="0,0,0,10">
                                        <!-- Property Selection -->
                                        <ComboBox Grid.Column="0" ItemsSource="{Binding $parent[Window].((vm:SmartCollectionEditorViewModel)DataContext).AvailableProperties}"
                                                  SelectedItem="{Binding PropertyName}" Margin="0,0,10,0" HorizontalAlignment="Stretch"/>
                                        
                                        <!-- Operator Selection -->
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding $parent[Window].((vm:SmartCollectionEditorViewModel)DataContext).AvailableOperators}"
                                                  SelectedItem="{Binding Operator}" Margin="0,0,10,0" HorizontalAlignment="Stretch"/>
                                        
                                        <!-- Value -->
                                        <TextBox Grid.Column="2" Text="{Binding Value}" Watermark="Value..." Margin="0,0,10,0"/>
                                        
                                        <!-- Remove Button -->
                                        <Button Grid.Column="3" Command="{Binding $parent[Window].((vm:SmartCollectionEditorViewModel)DataContext).RemoveRuleCommand}" 
                                                CommandParameter="{Binding}" Background="Transparent" Foreground="#FF5252">
                                            <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" 
                                                  Fill="#FF5252" Stretch="Uniform" Width="12"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    
                    <Button Grid.Row="1" Content="+ Add Rule" Command="{Binding AddRuleCommand}" 
                            HorizontalAlignment="Left" Margin="0,10,0,0" Background="#333" FontSize="12"/>
                </Grid>
            </Border>

            <!-- Actions -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="15" Margin="0,25,0,0">
                <Button Content="Cancel" Command="{Binding CancelCommand}" Background="Transparent" BorderThickness="0"/>
                <Button Content="Save Collection" 
                        Command="{Binding SaveCommand}" 
                        Background="#4CAF50" 
                        Foreground="White" 
                        Padding="25,10"
                        CornerRadius="10"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
