<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MyApp.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="MyApp.Desktop.Views.HarmonicMapView"
             x:DataType="vm:HarmonicMapViewModel"
             Background="#121212">

    <Grid>
        <!-- Overlay UI -->
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="20" Spacing="10">
            <TextBlock Text="Harmonic Map" FontSize="24" FontWeight="Light" Foreground="White"/>
            <TextBlock Text="Visualizing your Sound Space" FontSize="12" Foreground="Gray"/>
        </StackPanel>

        <!-- Node Details Popup -->
        <Border IsVisible="{Binding IsPopupVisible}" 
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="#252525" CornerRadius="20" Padding="30"
                MinWidth="300" BoxShadow="0 10 40 0 #A0000000">
            <StackPanel Spacing="15">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="{Binding SelectedNode.Key}" FontWeight="Bold" FontSize="24" Foreground="#4CAF50"/>
                    <Button Grid.Column="1" Command="{Binding ClosePopupCommand}" Background="Transparent" Padding="5">
                        <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" 
                              Fill="Gray" Stretch="Uniform" Width="12"/>
                    </Button>
                </Grid>
                
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding SelectedNode.Title}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="{Binding SelectedNode.Artist}" FontSize="14" Foreground="Gray"/>
                </StackPanel>

                <Button Command="{Binding PlayTrackCommand}" 
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="#4CAF50" Foreground="White" Padding="15,10" CornerRadius="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Path Data="M8 5v14l11-7z" Fill="White" Stretch="Uniform" Width="12"/>
                        <TextBlock Text="Play Now"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="20" Spacing="10">
            <Button Content="+" Width="40" Height="40" CornerRadius="20" Click="OnZoomIn"/>
            <Button Content="-" Width="40" Height="40" CornerRadius="20" Click="OnZoomOut"/>
            <Button Content="⟲" Width="40" Height="40" CornerRadius="20" Click="OnResetView"/>
        </StackPanel>

        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" 
                     VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Height="2" Margin="0,0,0,0"/>
    </Grid>
</UserControl>
