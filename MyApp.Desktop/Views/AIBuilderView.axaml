<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MyApp.Desktop.ViewModels"
             xmlns:entities="using:MyApp.Domain.Entities"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="MyApp.Desktop.Views.AIBuilderView"
             x:DataType="vm:AIBuilderViewModel">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="20" Margin="0,0,0,30">
            <TextBlock Text="AI Harmonic Playlist Builder" FontSize="28" FontWeight="Light" LetterSpacing="1.2"/>
            
            <Grid ColumnDefinitions="*, Auto, Auto" RowDefinitions="Auto, Auto">
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="5">
                    <TextBlock Text="Select Start Track" Foreground="Gray" FontSize="12"/>
                    <ComboBox ItemsSource="{Binding AvailableTracks}" 
                              SelectedItem="{Binding SelectedStartTrack}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="entities:Track">
                                <TextBlock Text="{Binding Title}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="20,0,0,0" Spacing="5">
                    <TextBlock Text="Length" Foreground="Gray" FontSize="12"/>
                    <NumericUpDown Value="{Binding PlaylistLength}" Minimum="2" Maximum="50" Width="120"/>
                </StackPanel>

                <Button Grid.Row="0" Grid.Column="2" 
                        Content="Generate Flow" 
                        Command="{Binding GenerateCommand}"
                        Classes="accent"
                        Margin="20,20,0,0"
                        VerticalAlignment="Bottom"/>
            </Grid>
        </StackPanel>

        <Border Grid.Row="1" CornerRadius="15" Background="#252525" ClipToBounds="True">
            <ListBox ItemsSource="{Binding GeneratedSequence}" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="dto:ScoredTrack">
                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" Margin="5">
                            <!-- Key Indicator -->
                            <Border Background="#333" CornerRadius="5" Padding="8,4" Width="45">
                                <TextBlock Text="{Binding Track.Key}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#4CAF50"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="15,0">
                                <TextBlock Text="{Binding Track.Title}" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="{Binding Track.Artist}" FontSize="11" Foreground="Gray"/>
                            </StackPanel>

                            <!-- Match Breakdown (The "Why") -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10" Margin="0,0,20,0">
                                <!-- Key Match -->
                                <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="Key Match Accuracy">
                                    <Path Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z" 
                                          Fill="{Binding Breakdown.KeyScore, Converter={StaticResource MoodToColorConverter}}" Stretch="Uniform" Width="10"/>
                                    <TextBlock Text="{Binding Breakdown.KeyScore, StringFormat={}{0:P0}}" FontSize="10" Foreground="Gray" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- BPM Match -->
                                <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="BPM Match Accuracy">
                                    <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.2 3.2.8-1.3-4.5-2.7V7z" 
                                          Fill="{Binding Breakdown.BpmScore, Converter={StaticResource MoodToColorConverter}}" Stretch="Uniform" Width="10"/>
                                    <TextBlock Text="{Binding Breakdown.BpmScore, StringFormat={}{0:P0}}" FontSize="10" Foreground="Gray" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- DNA Match -->
                                <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="DNA / Mood Match Accuracy">
                                    <Path Data="M19.8 18.4L14 10.67V6.5l1.35-1.69c.26-.33.03-.81-.39-.81H9.04c-.42 0-.65.48-.39.81L10 6.5v4.17L4.2 18.4c-.49.66-.02 1.6.8 1.6h14c.82 0 1.29-.94.8-1.6z" 
                                          Fill="{Binding Breakdown.DnaScore, Converter={StaticResource MoodToColorConverter}}" Stretch="Uniform" Width="10"/>
                                    <TextBlock Text="{Binding Breakdown.DnaScore, StringFormat={}{0:P0}}" FontSize="10" Foreground="Gray" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.Column="3" Text="{Binding Track.Bpm, StringFormat={}{0:F1}}" VerticalAlignment="Center" Foreground="Gray" FontSize="12" Width="40" TextAlignment="Right"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
